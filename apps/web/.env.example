# Nanking Atlas 公开站 — 本地开发环境变量样例
# 复制为 .env.local 后再修改。**禁止提交真实密钥。**

# 应用环境标识（development | test | staging | production）
NEXT_PUBLIC_APP_ENV=development

# API 基础 URL。P0 阶段可选；接入真实接口时必须配置。
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# 公开站正式域名（P2-06 canonical / sitemap / Open Graph 需要）。
# 未配置时页面不输出 metadataBase，并关闭索引，避免把 localhost 当作规范地址。
# NEXT_PUBLIC_SITE_URL=https://example.invalid

# 发布后 revalidation 的 HMAC 密钥（服务端专用，绝不能带 NEXT_PUBLIC_ 前缀）。
# API 用同一密钥对 `${timestamp}.${body}` 做 HMAC-SHA256 后调用 POST /api/revalidate。
# 留空时接收端返回 503，不会跳过签名校验。
# REVALIDATION_SECRET=replace-with-a-randomly-generated-secret