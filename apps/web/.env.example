# 公开站本地开发环境变量样例
# 复制为 .env.local 后再修改。**禁止提交真实密钥。**

# 应用环境标识（development | test | staging | production）
NEXT_PUBLIC_APP_ENV=development

# API 基础地址。留空时页面走"内容暂不可用"降级，不会报错。
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# 高德地图接入。两者**成对**有效：JS API 2.0 强制要求安全密钥，
# 只配 Key 会白屏，且路径规划/地理编码等 Web 服务会**静默**无结果。
# 缺失任一项时 /map 整块降级为纯列表（§9.2 允许的降级，不报错）。
# 申请路径：高德开放平台 → 应用管理 → 我的应用 → 添加 Key → 服务平台选「Web 端(JS API)」。
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# 站点规范域名。canonical / Open Graph / sitemap 都以它为准。
# 留空时不输出 canonical，页面标 noindex —— 避免把 canonical 指到错误域名。
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 发布 → 站点收敛的签名密钥（≥ 32 字符），必须与 apps/api 的
# REVALIDATION_SECRET 一致。未配置时 POST /api/revalidate 一律 503。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REVALIDATION_SECRET=dev-only-insecure-revalidation-secret-override