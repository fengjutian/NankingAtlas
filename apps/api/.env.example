# Nanking Atlas API — 本地开发环境变量样例
# 复制为 .env 后再修改。**禁止提交真实密钥。**

# 应用环境标识（development | test | staging | production）
APP_ENV=development

# Node 运行时环境（development | test | production）；与 APP_ENV 区分，避免误用
NODE_ENV=development

# API 监听端口（默认 4000）
API_PORT=4000

# 公开站与管理后台源（P1 起用于 CORS 白名单）
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# 结构化日志级别（fatal | error | warn | info | debug | trace | silent）
LOG_LEVEL=info

# Request ID 透传的 HTTP 头名（默认 x-request-id；可改成 x-correlation-id 等）
REQUEST_ID_HEADER=x-request-id

# Prisma + SQLite 连接串。apps/api 启服时 cwd = apps/api，
# 故用 `../packages/database/prisma/dev.db` 指向 packages/database/prisma/dev.db。
# 共享一个 dev.db 给本地开发；集成测试用同名文件但不同位置。
DATABASE_URL=file:../packages/database/prisma/dev.db

# ---- 认证（P1-02）----
#
# 两个 secret 都必须 ≥ 32 字符；生产环境缺省会 fail-fast。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# 本地可保留下面的 dev 占位值；生产必须由部署平台注入真实值。
AUTH_ACCESS_SECRET=dev-only-insecure-access-secret-please-override
AUTH_REFRESH_SECRET=dev-only-insecure-refresh-secret-please-override

# access token 有效期（秒；60 ~ 3600，默认 900 = 15 分钟）
AUTH_ACCESS_TTL_SECONDS=900

# refresh token 有效期（秒；300 ~ 2592000，默认 1209600 = 14 天）
AUTH_REFRESH_TTL_SECONDS=1209600

# 登录端点限流（次 / 分钟 / IP；默认 5）。
# 集成测试里所有登录用例共享 127.0.0.1，会抢配额 —— 测试配置会覆盖成大值。
AUTH_LOGIN_RATE_LIMIT=5

# ---- 发布 → 站点收敛（P2-07）----
#
# revalidation 签名密钥（≥ 32 字符）。web 端 `POST /api/revalidate` 用同一密钥校验。
# 生产必须注入真实值；未注入时 production 会 fail-fast。
REVALIDATION_SECRET=dev-only-insecure-revalidation-secret-override

# web 端 revalidate 端点地址。
# 未配置时发布流程**跳过** revalidation（技术方案 §9.1：发布事务不依赖站点成功）。
# 生产必须配置，否则 APP_ENV=production 会 fail-fast。
# REVALIDATION_URL=https://your-site.example.com/api/revalidate