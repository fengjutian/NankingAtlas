# Nanking Atlas API — 本地开发环境变量样例
# 复制为 .env 后再修改。**禁止提交真实密钥。**

# 应用环境标识（development | test | staging | production）
APP_ENV=development

# Node 运行时环境（development | test | production）；与 APP_ENV 区分，避免误用
NODE_ENV=development

# API 监听端口（默认 4000）
API_PORT=4000

# 公开站与管理后台源（P1 起用于 CORS 白名单）
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# 结构化日志级别（fatal | error | warn | info | debug | trace | silent）
LOG_LEVEL=info

# Request ID 透传的 HTTP 头名（默认 x-request-id；可改成 x-correlation-id 等）
REQUEST_ID_HEADER=x-request-id

# Prisma + SQLite 连接串。apps/api 启服时 cwd = apps/api，
# 故用 `../packages/database/prisma/dev.db` 指向 packages/database/prisma/dev.db。
# 共享一个 dev.db 给本地开发；集成测试用同名文件但不同位置。
DATABASE_URL=file:../packages/database/prisma/dev.db