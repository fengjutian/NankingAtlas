# Nanking Atlas API — 本地开发环境变量样例
# 复制为 .env 后再修改。**禁止提交真实密钥。**

# 应用环境标识（development | test | staging | production）
APP_ENV=development

# Node 运行时环境（development | test | production）；与 APP_ENV 区分，避免误用
NODE_ENV=development

# API 监听端口（默认 4000）
API_PORT=4000

# 公开站与管理后台源（P1 起用于 CORS 白名单）
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173