{
  "name": "@nanking-atlas/api",
  "version": "0.0.0",
  "private": true,
  "description": "Nanking Atlas 统一 API (NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "tsx src/main.ts",
    "start:dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "clean": "rimraf dist coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check-breaking": "tsx scripts/check-openapi-breaking.ts",
    "load:baseline": "node scripts/load-baseline.mjs"
  },
  "dependencies": {
    "@nanking-atlas/database": "workspace:*",
    "@nanking-atlas/validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.41.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nanking-atlas/eslint-config": "workspace:*",
    "@nanking-atlas/tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.2.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "webpack": "^5.97.1"
  }
}
