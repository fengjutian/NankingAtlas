// Nanking Atlas Prisma schema.
//
// 范围：覆盖 MVP（P1 ~ P3）的所有表与字段。PostgreSQL/PostGIS 作为权威数据源，
// 事务、约束、空间查询都在服务端执行。空间列使用 Unsupported("geography(Point,4326)")，
// 由 Prisma 迁移产生的 SQL 在 PR review 中人工核对。
//
// 设计约束：
//   - revisions / review_actions / audit_logs 永远只增不改（应用层禁止 DELETE）。
//   - 所有软删除使用 archived_at / disabled_at 时间戳，普通 DELETE 不允许级联破坏追溯记录。
//   - update 使用乐观锁 @version，所有写冲突返回 409（应用层处理）。
//   - 真实经纬度使用 PostGIS geography(POINT,4326)；无可靠坐标时 geom 必须为 NULL（应用层校验）。
//   - search 全文检索与中文分词在 P3 由 pg_trgm / ILIKE 组合承担；本 schema 不引入额外扩展。
//
// 技术依据：docs/TECHNICAL_IMPLEMENTATION.md §4 数据模型与 §11 搜索实现。

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // 把生成 client 落到本包内，方便 apps/api 单例热重载。
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ============================================================================
// 枚举
// ============================================================================

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum ContentType {
  PLACE
  PERSON
  EVENT
  ARCHITECTURE
  TRADITION
  TOPIC
  ROUTE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum Language {
  ZH
  EN
}

enum VerificationStatus {
  UNVERIFIED
  PARTIAL
  VERIFIED
  DISPUTED
}

enum PlaceAccuracy {
  EXACT
  APPROXIMATE
  AREA_ONLY
  UNKNOWN
}

enum SourceKind {
  ARCHIVE
  BOOK
  ARTICLE
  WEBSITE
  ORAL
  OTHER
}

enum MediaRightsStatus {
  PUBLIC_DOMAIN
  CC_BY
  CC_BY_SA
  CC_BY_NC
  CC_BY_NC_SA
  CC0
  LICENSED
  UNKNOWN
  RESTRICTED
}

enum MediaUsage {
  HERO
  GALLERY
  ILLUSTRATION
  ATTACHMENT
}

enum ReviewActionKind {
  SUBMIT
  APPROVE
  REJECT
  PUBLISH
  ARCHIVE
  REQUEST_CHANGES
}

enum RelationType {
  RELATED_TO
  PART_OF
  INFLUENCED
  CONTINUES
  REFERENCES
  LOCATED_AT
}

// ============================================================================
// 身份与权限
// ============================================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles              UserRole[]      @ignore
  userRoles          UserRoleAssignment[]
  refreshTokens      RefreshToken[]
  createdContents    Content[]       @relation("ContentCreatedBy")
  updatedContents    Content[]       @relation("ContentUpdatedBy")
  createdRevisions   Revision[]
  reviewActions      ReviewAction[]
  auditLogs          AuditLog[]
  createdMedia       Media[]
  uploads            UploadIntent[]

  @@map("users")
}

// 注：Prisma 不直接支持 string[]；上方的 `roles UserRole[] @ignore` 仅为提示
// 应用层通过下方的 UserRoleAssignment 关联表查询角色。
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?  @map("user_agent") @db.Text
  ipHash    String?  @map("ip_hash") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// 内容主表 + 类型扩展
// ============================================================================

model Content {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        ContentType
  slug        String        @unique
  title       String
  subtitle    String?
  summary     String?
  bodyJson    Json          @map("body_json")
  status      ContentStatus @default(DRAFT)
  language    Language      @default(ZH)
  version     Int           @default(1)
  createdById String        @map("created_by") @db.Uuid
  updatedById String        @map("updated_by") @db.Uuid
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User             @relation("ContentCreatedBy", fields: [createdById], references: [id])
  updatedBy User             @relation("ContentUpdatedBy", fields: [updatedById], references: [id])
  place     Place?
  person    Person?
  event     Event?
  architecture Architecture?
  tradition Tradition?
  topic     Topic?
  route     Route?
  revisions Revision[]
  reviewActions ReviewAction[]
  sources   ContentSource[]
  media     ContentMedia[]
  tags      ContentTag[]
  relationsFrom ContentRelation[] @relation("RelationFrom")
  relationsTo   ContentRelation[] @relation("RelationTo")
  routeStops RouteStop[]

  @@index([type, status])
  @@index([status, publishedAt(sort: Desc)])
  @@index([slug])
  @@map("contents")
}

model Place {
  contentId          String   @id @map("content_id") @db.Uuid
  address             String?
  geom                Unsupported("geography(Point, 4326)")?
  accuracy            PlaceAccuracy @default(UNKNOWN)
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("places")
}

model Person {
  contentId       String  @id @map("content_id") @db.Uuid
  birthText       String? @map("birth_text")
  deathText       String? @map("death_text")
  biographyNote   String? @map("biography_note")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("people")
}

model Event {
  contentId      String  @id @map("content_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  datePrecision  String  @default("UNKNOWN") @map("date_precision")
  dateNote       String? @map("date_note")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Architecture {
  contentId         String  @id @map("content_id") @db.Uuid
  builtPeriod       String? @map("built_period")
  currentCondition  String? @map("current_condition")
  heritageLevel     String? @map("heritage_level")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("architectures")
}

model Tradition {
  contentId           String  @id @map("content_id") @db.Uuid
  traditionType       String  @map("tradition_type")
  transmissionMethod  String? @map("transmission_method")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("traditions")
}

model Topic {
  contentId    String  @id @map("content_id") @db.Uuid
  curatorNote  String? @map("curator_note")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("topics")
}

model Route {
  contentId       String  @id @map("content_id") @db.Uuid
  durationMinutes Int?    @map("duration_minutes")
  distanceMeters  Int?    @map("distance_meters")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  stops   RouteStop[]

  @@map("routes")
}

model RouteStop {
  routeId   String @map("route_id") @db.Uuid
  position  Int
  placeId   String @map("place_id") @db.Uuid
  note      String?

  route  Route    @relation(fields: [routeId], references: [contentId], onDelete: Cascade)
  place  Content  @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@id([routeId, position])
  @@index([placeId])
  @@map("route_stops")
}

// ============================================================================
// 内容关联 / 来源 / 媒体 / 标签
// ============================================================================

model ContentRelation {
  sourceContentId String       @map("source_content_id") @db.Uuid
  targetContentId String       @map("target_content_id") @db.Uuid
  relationType    RelationType @map("relation_type")
  directionNote   String?      @map("direction_note")

  source Content @relation("RelationFrom", fields: [sourceContentId], references: [id], onDelete: Cascade)
  target Content @relation("RelationTo",   fields: [targetContentId], references: [id], onDelete: Cascade)

  @@id([sourceContentId, targetContentId, relationType])
  @@index([targetContentId])
  @@map("content_relations")
}

model Source {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            SourceKind
  title           String
  author          String?
  publisher       String?
  publicationDate DateTime? @map("publication_date") @db.Date
  url             String?
  accessedAt      DateTime? @map("accessed_at") @db.Timestamptz(6)
  citationText    String?   @map("citation_text")
  verificationNote String?  @map("verification_note")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contents ContentSource[]

  @@map("sources")
}

model ContentSource {
  contentId     String  @map("content_id") @db.Uuid
  sourceId      String  @map("source_id") @db.Uuid
  claimScope    String  @map("claim_scope")
  pageReference String? @map("page_reference")
  isPrimary     Boolean @default(false) @map("is_primary")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([contentId, sourceId, claimScope])
  @@index([sourceId])
  @@map("content_sources")
}

model Media {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectKey    String           @unique @map("object_key")
  mimeType     String           @map("mime_type")
  size         Int
  width        Int?
  height       Int?
  checksum     String
  creator      String?
  rightsStatus MediaRightsStatus @default(UNKNOWN) @map("rights_status")
  license      String?
  creditLine   String?          @map("credit_line")
  altText      String           @map("alt_text")
  createdById  String           @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy     User         @relation(fields: [createdById], references: [id])
  contents      ContentMedia[]
  uploadIntent  UploadIntent?

  @@map("media")
}

model ContentMedia {
  contentId String      @map("content_id") @db.Uuid
  mediaId   String      @map("media_id") @db.Uuid
  usage     MediaUsage
  position  Int         @default(0)
  caption   String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId],   references: [id], onDelete: Restrict)

  @@id([contentId, mediaId, usage])
  @@index([mediaId])
  @@map("content_media")
}

model Tag {
  slug        String   @id
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String @map("content_id") @db.Uuid
  tagSlug   String @map("tag_slug")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagSlug],   references: [slug],  onDelete: Restrict)

  @@id([contentId, tagSlug])
  @@index([tagSlug])
  @@map("content_tags")
}

// ============================================================================
// 上传意图
// ============================================================================

model UploadIntent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId     String   @unique @map("media_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  objectKey   String   @map("object_key")
  uploadUrl   String   @map("upload_url")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  media    Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@map("upload_intents")
}

// ============================================================================
// 版本 / 审核 / 审计（只增不改）
// ============================================================================

model Revision {
  contentId   String   @map("content_id") @db.Uuid
  revisionNo  Int      @map("revision_no")
  snapshotJson Json    @map("snapshot_json")
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@id([contentId, revisionNo])
  @@index([contentId, createdAt(sort: Desc)])
  @@map("revisions")
}

model ReviewAction {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId  String           @map("content_id") @db.Uuid
  action     ReviewActionKind
  fromStatus ContentStatus    @map("from_status")
  toStatus   ContentStatus    @map("to_status")
  comment    String?
  actorId    String           @map("actor_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId],   references: [id], onDelete: Restrict)

  @@index([contentId, createdAt(sort: Desc)])
  @@map("review_actions")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  requestId  String?  @map("request_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}