// Nanking Atlas Prisma schema (SQLite 方案)。
//
// 范围：覆盖 MVP（P1 ~ P3）所有表与字段的最小可工作映射。
//
// 与 PostgreSQL 版本的差异：
//   - 无 PostGIS：places.geom 改为 lon / lat 浮点列；P3 地图的 bbox 检索改用 R*Tree 虚表
//     （由额外 migration 引入，不在 Prisma model 中表达）。
//   - 无 pg_trgm：P3 搜索降级为 LIKE + 应用层分词；FTS5 留作 P3 子任务。
//   - 无 citext / pgcrypto：email 改为 String + 应用层 toLowerCase；UUID 改为 cuid()。
//   - 无 enum：所有 enum 列改 String；schema.prisma 不写 enum 类型。
//     应用层通过 packages/database/src/enums.ts 的字面量联合 + zod 校验。
//
// 决策来源：用户在 DEVELOPER 阶段指示"用 SQLite 即可"，不再使用 PostgreSQL/PostGIS。
// 此 schema 与原 POSTGIS 版本在语义上有差异（无空间查询、无中文 trigram），P3
// 地图/搜索相关任务需要按 SQLite 能力范围重写。

generator client {
  provider = "prisma-client-js"
  // 不显式设置 output：使用 Prisma 默认位置 `node_modules/@prisma/client`。
  // 单一 client 被 apps/api/src/lib/prisma.ts 单例包装；web/admin 不会直接 import。
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 内容主表 + 类型扩展（应用层 enum 校验见 packages/database/src/enums.ts）
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles          UserRoleAssignment[]
  refreshTokens      RefreshToken[]
  createdContents    Content[]           @relation("ContentCreatedBy")
  updatedContents    Content[]           @relation("ContentUpdatedBy")
  createdRevisions   Revision[]
  reviewActions      ReviewAction[]
  auditLogs          AuditLog[]
  createdMedia       Media[]
  uploads            UploadIntent[]

  @@map("users")
}

model UserRoleAssignment {
  userId    String   @map("user_id")
  role      String
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ipHash    String?   @map("ip_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Content {
  id          String    @id @default(cuid())
  type        String
  slug        String    @unique
  title       String
  subtitle    String?
  summary     String?
  bodyJson    String    @map("body_json")
  status      String    @default("DRAFT")
  language    String    @default("ZH")
  version     Int       @default(1)
  createdById String    @map("created_by")
  updatedById String    @map("updated_by")
  publishedAt DateTime? @map("published_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User             @relation("ContentCreatedBy", fields: [createdById], references: [id])
  updatedBy User             @relation("ContentUpdatedBy", fields: [updatedById], references: [id])
  place     Place?
  person    Person?
  event     Event?
  architecture Architecture?
  tradition Tradition?
  topic     Topic?
  route     Route?
  revisions Revision[]
  reviewActions ReviewAction[]
  sources   ContentSource[]
  media     ContentMedia[]
  tags      ContentTag[]
  relationsFrom ContentRelation[] @relation("RelationFrom")
  relationsTo   ContentRelation[] @relation("RelationTo")
  routeStops RouteStop[]

  @@index([type, status])
  @@index([status, publishedAt(sort: Desc)])
  @@index([slug])
  @@map("contents")
}

// SQLite 替代 PostGIS geography：用两个 float 列表达经纬度；
// 实际空间索引由额外 SQL migration 创建 R*Tree 虚表（参见后续 P3 子任务）。
model Place {
  contentId          String  @id @map("content_id")
  address            String?
  lon                Float?
  lat                Float?
  accuracy           String  @default("UNKNOWN")
  verificationStatus String  @default("UNVERIFIED") @map("verification_status")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("places")
}

model Person {
  contentId       String  @id @map("content_id")
  birthText       String? @map("birth_text")
  deathText       String? @map("death_text")
  biographyNote   String? @map("biography_note")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("people")
}

model Event {
  contentId      String    @id @map("content_id")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  datePrecision  String    @default("UNKNOWN") @map("date_precision")
  dateNote       String?   @map("date_note")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Architecture {
  contentId         String  @id @map("content_id")
  builtPeriod       String? @map("built_period")
  currentCondition  String? @map("current_condition")
  heritageLevel     String? @map("heritage_level")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("architectures")
}

model Tradition {
  contentId           String  @id @map("content_id")
  traditionType       String  @map("tradition_type")
  transmissionMethod  String? @map("transmission_method")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("traditions")
}

model Topic {
  contentId    String  @id @map("content_id")
  curatorNote  String? @map("curator_note")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("topics")
}

model Route {
  contentId       String  @id @map("content_id")
  durationMinutes Int?    @map("duration_minutes")
  distanceMeters  Int?    @map("distance_meters")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  stops   RouteStop[]

  @@map("routes")
}

model RouteStop {
  routeId   String @map("route_id")
  position  Int
  placeId   String @map("place_id")
  note      String?

  route  Route    @relation(fields: [routeId], references: [contentId], onDelete: Cascade)
  place  Content  @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@id([routeId, position])
  @@index([placeId])
  @@map("route_stops")
}

// ============================================================================
// 内容关联 / 来源 / 媒体 / 标签
// ============================================================================

model ContentRelation {
  sourceContentId String  @map("source_content_id")
  targetContentId String  @map("target_content_id")
  relationType    String  @map("relation_type")
  directionNote   String? @map("direction_note")

  source Content @relation("RelationFrom", fields: [sourceContentId], references: [id], onDelete: Cascade)
  target Content @relation("RelationTo",   fields: [targetContentId], references: [id], onDelete: Cascade)

  @@id([sourceContentId, targetContentId, relationType])
  @@index([targetContentId])
  @@map("content_relations")
}

model Source {
  id              String    @id @default(cuid())
  kind            String
  title           String
  author          String?
  publisher       String?
  publicationDate DateTime? @map("publication_date")
  url             String?
  accessedAt      DateTime? @map("accessed_at")
  citationText    String?   @map("citation_text")
  verificationNote String?  @map("verification_note")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  contents ContentSource[]

  @@map("sources")
}

model ContentSource {
  contentId     String  @map("content_id")
  sourceId      String  @map("source_id")
  claimScope    String  @map("claim_scope")
  pageReference String? @map("page_reference")
  isPrimary     Boolean @default(false) @map("is_primary")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([contentId, sourceId, claimScope])
  @@index([sourceId])
  @@map("content_sources")
}

model Media {
  id           String    @id @default(cuid())
  objectKey    String    @unique @map("object_key")
  mimeType     String    @map("mime_type")
  size         Int
  width        Int?
  height       Int?
  checksum     String
  creator      String?
  rightsStatus String    @default("UNKNOWN") @map("rights_status")
  license      String?
  creditLine   String?   @map("credit_line")
  altText      String    @map("alt_text")
  createdById  String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  createdBy     User         @relation(fields: [createdById], references: [id])
  contents      ContentMedia[]
  uploadIntent  UploadIntent?

  @@map("media")
}

model ContentMedia {
  contentId String @map("content_id")
  mediaId   String @map("media_id")
  usage     String
  position  Int    @default(0)
  caption   String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId],   references: [id], onDelete: Restrict)

  @@id([contentId, mediaId, usage])
  @@index([mediaId])
  @@map("content_media")
}

model Tag {
  slug        String   @id
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String @map("content_id")
  tagSlug   String @map("tag_slug")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagSlug],   references: [slug],  onDelete: Restrict)

  @@id([contentId, tagSlug])
  @@index([tagSlug])
  @@map("content_tags")
}

// ============================================================================
// 上传意图
// ============================================================================

model UploadIntent {
  id         String   @id @default(cuid())
  mediaId    String   @unique @map("media_id")
  uploaderId String   @map("uploader_id")
  objectKey  String   @map("object_key")
  uploadUrl  String   @map("upload_url")
  expiresAt  DateTime @map("expires_at")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at")

  media    Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@map("upload_intents")
}

// ============================================================================
// 版本 / 审核 / 审计（只增不改）
// ============================================================================

model Revision {
  contentId    String   @map("content_id")
  revisionNo   Int      @map("revision_no")
  snapshotJson String   @map("snapshot_json")
  createdById  String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@id([contentId, revisionNo])
  @@index([contentId, createdAt(sort: Desc)])
  @@map("revisions")
}

model ReviewAction {
  id         String   @id @default(cuid())
  contentId  String   @map("content_id")
  action     String
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  comment    String?
  actorId    String   @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId],   references: [id], onDelete: Restrict)

  @@index([contentId, createdAt(sort: Desc)])
  @@map("review_actions")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  requestId  String?  @map("request_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeJson String?  @map("before_json")
  afterJson  String?  @map("after_json")
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}