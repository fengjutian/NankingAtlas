{
  "name": "@nanking-atlas/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema、迁移、seed 与共享 Prisma client 单例。仅 apps/api 可导入；web/admin 禁止直连。",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
