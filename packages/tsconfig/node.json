{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node.js (application)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false
  }
}
